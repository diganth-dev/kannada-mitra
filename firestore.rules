rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated users can read and write only their own user profile document
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Subcollections (if any) are also strictly isolated to the document owner
      match /{document=**} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // Deny all other collections and documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
