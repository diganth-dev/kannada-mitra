# ==============================================================================
# Kannada Mitra — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env (or .env.local) to configure your local credentials.
#
# IMPORTANT SECURITY RULES:
# 1. Variables with VITE_ are public and bundled into browser-side JavaScript.
# 2. Variables WITHOUT VITE_ (like AI_API_KEY) are PRIVATE and used only by
#    server-side API endpoints. Never add VITE_ to private secret keys!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Web App Configuration (Browser-Facing)
# ------------------------------------------------------------------------------
# Obtain from Firebase Console > Project Settings > General > Your Apps > Web App
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------------------------
# 2. AI Tutor Server-Side Configuration (Private — Kept on Server Only)
# ------------------------------------------------------------------------------
# Obtain your Gemini API key from Google AI Studio: https://aistudio.google.com/
# Gemini Flash offers 15 RPM (Requests Per Minute) and 1,500 RPD.
#
# Replace the placeholder with your private key in .env:
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.8-flash
AI_PROVIDER=gemini
